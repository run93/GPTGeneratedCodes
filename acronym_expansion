import re

def solve_shorthand_complete(text, shorthand):
    # 1. Normalize shorthand (remove underscores/spaces)
    # 'trdcnt' stays 'trdcnt', 'mg_score' becomes 'mgscore'
    clean_short = re.sub(r'[^a-zA-Z0-9]', '', shorthand).lower()
    if not clean_short: return "Invalid input"

    # ---------------------------------------------------------
    # STEP 1: MARK (Word-Aware Regex)
    # \b          -> Start at the beginning of a word
    # {first}     -> The first letter of your shorthand
    # (?:.|\n)*?  -> Any characters (lazy) until...
    # {last}      -> The last letter of your shorthand
    # \w*\b       -> The rest of that word and the boundary
    # ---------------------------------------------------------
    first, last = clean_short[0], clean_short[-1]
    
    # We use a non-greedy catch-all between the first and last letters.
    # We then verify the internal sequence in Step 2.
    pattern = rf"\b{re.escape(first)}(?:.|\n)*?{re.escape(last)}\w*\b"
    
    # Find overlapping matches to ensure we find the "tightest" one
    # (e.g., ignoring "to calculate the" if "trade" also starts with 't')
    search_pattern = f"(?=({pattern}))"
    potential_spans = [m.group(1) for m in re.finditer(search_pattern, text, re.IGNORECASE)]

    # ---------------------------------------------------------
    # STEP 2: FIND MOST POTENTIAL COMBINATION
    # We filter out spans that don't contain ALL shorthand letters in order,
    # then we pick the one with the highest character density.
    # ---------------------------------------------------------
    valid_candidates = []
    
    for span in potential_spans:
        # Check if shorthand characters appear in order within this span
        it = iter(span.lower())
        if all(char in it for char in clean_short):
            valid_candidates.append(span)

    if not valid_candidates:
        return ""

    # Density Score = (Length of shorthand) / (Length of result)
    # This ensures "trade count" wins over "to calculate the daily trade count"
    def score(candidate):
        # We also penalize for excessive number of words to keep it tight
        word_count = len(candidate.split())
        return (len(clean_short) / len(candidate)) - (word_count * 0.01)

    return max(set(valid_candidates), key=score)

# --- Test Bench ---
test_data = [
    ("umls", "The Unified System Lexicon."), #The Unified Medical Language System Lexicon
    ("mg", "Data from the mortgage rate table."),
    ("trdcnt", "The total trade count was recorded.")
]

print(f"{'INPUT':<10} | {'RESULT'}")
print("-" * 45)
for short, paragraph in test_data:
    print(f"{short:<10} | {solve_shorthand_complete(paragraph, short)}")
