def random_columns(domain_key):
    pool = common_cols + domain_cols.get(domain_key, [])
    return random.sample(pool, 5)

rows = []
years = list(range(2016, datetime.utcnow().year + 1))
for i in range(N):
    domain = random.choice(list(domains.keys()))
    topic = random.choice(domains[domain])
    region = random.choice(regions)
    suff = random.choice(suffixes)
    year = random.choice(years)
    src = random.choice(sources)
    store = random.choice(storage)
    cov = random.choice(coverage)

    dataset_name = f"{domain}: {topic.title()} {suff} ({region}, {year})"

    desc = (
        f"This dataset contains {src} {topic} related to {domain.lower()} across {region}. "
        f"Data is stored as {store} with coverage {cov}. "
        f"Includes anonymized records suitable for analytics and modeling."
    )

    cols = random_columns(domain)
    rows.append({
        "dataset_name": dataset_name,
        "dataset_description": desc,
        "attribute_names": json.dumps(cols, ensure_ascii=False)
    })

df = pd.DataFrame(rows)

# Save to CSV
out_path = "./synthetic_datasets_10k.csv"
df.to_csv(out_path, index=False)



